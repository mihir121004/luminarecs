# Environment and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/

# Django runtime files
db.sqlite3
staticfiles/
media/
logs/

# Generated ML artifacts (store/version these outside the source tree)
platform_engine/ml_engine/model_data/
platform_engine/ml_models/
*.pkl
*.index
*.faiss

# Deployment (HF Space): ship the trained ML artifacts (~16 MB) so the free
# deployment serves working recommendations out of the box. Negations must
# come AFTER the exclusion rules above to take effect.
!platform_engine/ml_engine/model_data/
!platform_engine/ml_engine/model_data/**

# Tooling and editor files
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
.idea/
.vscode/

# Local dev tools (MailHog binary downloaded by scripts/mailhog.sh)
scripts/.bin/

# macOS AppleDouble junk
._*
