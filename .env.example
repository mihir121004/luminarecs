# ==========================================================================
# LUMINARECS — PRODUCTION ENVIRONMENT TEMPLATE
#
#   cp .env.example .env      # on the production server
#   nano .env                 # fill EVERY value below
#   ./scripts/deploy.sh       # validates then starts the stack
#
# Secrets: never commit the real .env (git-ignored). Generate fresh values:
#   SECRET_KEY / passwords -> python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ==========================================================================

# ---- REQUIRED: core application secrets ---------------------------------
SECRET_KEY=
DEBUG=False

# Public domain for Caddy's automatic HTTPS certificates + host checking.
DOMAIN=luminarecs.com
ACME_EMAIL=you@luminarecs.com
ALLOWED_HOSTS=luminarecs.com,www.luminarecs.com

# ---- REQUIRED: database & cache secrets (min 16 chars each!) -------------
DB_NAME=luminarecs_db
DB_USER=luminarecs
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

# ---- Security headers (already enforced by settings when DEBUG=False) -----
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CSRF/CORS — defaults derive from DOMAIN; override only to add hosts.
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
# Set to True only for temporary local debugging; NEVER in production.
CORS_ALLOW_ALL_ORIGINS=False

# ---- EMAIL — real delivery ----------------------------------------------
# Use a Google ACCOUNT APP PASSWORD (16 chars), NOT your normal password.
# Create at: https://myaccount.google.com/apppasswords  (needs 2FA on)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=

# Password-reset emails always point at DOMAIN above; override only if the
# public URL differs (e.g. a dedicated www host).
PASSWORD_RESET_LINK_DOMAIN=
PASSWORD_RESET_LINK_PROTOCOL=https

# ---- Logging / monitoring -------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# ---- AI/ML Configuration --------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=ml_models/movie_index.faiss
RECOMMENDATION_CACHE_TTL=3600

# ---- OAuth login providers (empty = button hidden on login/signup) --------
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_GITHUB_KEY=
SOCIAL_AUTH_GITHUB_SECRET=

# ---- Gunicorn capacity (defaults fine for a 4GB VM) ------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
